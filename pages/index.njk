My perfectionism therapy; every post here is a hard-fought victory.

<ul class="post-list">
{% for post in collections.posts | reverse %}
	<li>
		<time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("LLL d, yyyy") }}</time>
		<a href="{{ post.url }}">{{ post.data.title }}</a>
	</li>
{% endfor %}
</ul>
